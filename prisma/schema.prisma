// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Trip {
  id                String   @id @default(uuid())
  name              String
  description       String?
  listingUrl        String? // Airbnb/VRBO URL
  listingTitle      String?
  listingCoverPhoto String?
  checkInDate       DateTime
  checkOutDate      DateTime
  rsvpByDate        DateTime? // Optional: RSVP-by date for guests
  totalCost         Float    @default(0) // Total cost of the rental (0 when costSharingEnabled = false)
  pricingModel      String   @default("PER_PERSON") // "per_room" | "per_bed" | "per_person" | "per_person_per_night"
  isPublished       Boolean  @default(false)
  timezone          String   @default("UTC")
  location          String?
  inviteMode        String   @default("approval_required") // "approval_required" | "open"
  costSharingEnabled    Boolean @default(true) // When false, hides all cost/payment UX
  activitiesEnabled     Boolean @default(true) // When false, hides Activities nav + itinerary activity creation
  gamesEnabled          Boolean @default(true) // When false, hides Games nav
  platformFeePerPerson  Float   @default(0)  // Per-guest share of the Divvi fee (set when host splits the cost)
  publishFeePaymentIntentId String? @unique // Stripe PI id for one-time publish fee (prevents reuse across trips)

  // Trip info / house rules (editable on dashboard)
  fullAddress       String?  // Full address for maps; auto-populated from creation address
  locationCity      String?  // City name for hero display
  checkInTime       String?
  checkOutTime      String?
  parkingNotes      String?
  houseRules        String?
  whatToBring       String?
  petsAllowed       Boolean?
  childrenAllowed   Boolean?
  tripNotes         String?
  tripInfoEditedAt  DateTime? // Set when user edits trip info section (for reminder)

  // New pricing fields
  expectedPeopleCount Int? // Expected number of people (for PER_PERSON mode)
  maxGuests           Int? // Max guests from property listing
  allowPartialStays   Boolean @default(false) // Toggle for partial stay reservations

  // Pricing settings (stored as JSON for flexibility)
  bedWeights           String? // JSON: {"king": 1.00, "queen": 0.75, "twin": 0.50, ...}
  sharingExponentAlpha Float   @default(0.60) // Sharing discount exponent (0.3-0.9)
  privacyPremiumP      Float   @default(0.00) // Privacy premium (0-0.25)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms                Room[]
  reservations         Reservation[]
  members              TripMember[]
  invites              Invite[]
  roomAssignments      RoomAssignment[]
  mealPlan             MealPlan?
  mealSlots            MealSlot[]
  activities           Activity[]
  extraCostRules       ExtraCostRule[]
  guestExtraSelections GuestExtraSelection[]
  rsvps                RSVP[]
  guestProfiles        GuestProfile[]
  invoices             Invoice[]
  notifications        Notification[]
  chatMessages         ChatMessage[]
  tripActivities       TripActivity[]
  polls                Poll[]
  captionThisRounds    CaptionThisRound[]
  captionThisScores   CaptionThisScore[]
  tripGames           TripGame[]
  files               TripFile[]

  @@index([isPublished])
}

model Room {
  id               Int      @id @default(autoincrement())
  tripId           String
  name             String
  /// Wizard room kind: bedroom, living-room, master-bedroom, etc. (optional; used in UI when no photo)
  roomType         String?
  description      String?
  baseRateModifier Float    @default(1.0)
  photoUrls        String[] // Array of photo URLs
  maxOccupancy     Int? // Max people per room
  privacyFactor    Float    @default(1.0) // 1.0 shared, 1.25 private
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trip              Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  beds              Bed[]
  reservations      Reservation[]
  legacySubmissions GuestSubmission[] // Legacy support
  roomAssignments   RoomAssignment[]

  @@index([tripId])
}

model Bed {
  id            String   @id @default(uuid())
  roomId        Int
  bedType       String // "king" | "queen" | "twin" | "bunk" | "sofa" | "full" | etc.
  nightlyRate   Float? // Optional: can be calculated on-the-fly
  capacity      Int      @default(1) // Number of people per bed (legacy)
  capacitySlots Int      @default(1) // Number of sleep slots (for canonical model)
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  room              Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reservations      Reservation[]
  legacySubmissions GuestSubmission[] // Legacy support
  roomAssignments   RoomAssignment[]

  @@index([roomId])
  @@index([isAvailable])
}

model Reservation {
  id              String   @id @default(uuid())
  tripId          String
  name            String
  email           String
  roomId          Int
  bedId           String?
  checkInDate     DateTime
  checkOutDate    DateTime
  nights          Int
  numberOfGuests  Int      @default(1)
  numberOfSlots   Int      @default(1) // Number of sleep slots reserved
  calculatedPrice Float
  pricingSnapshot String? // JSON snapshot of pricing at time of reservation
  submittedAt     DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id])
  bed  Bed? @relation(fields: [bedId], references: [id])

  @@index([email])
  @@index([tripId])
  @@index([roomId])
  @@index([bedId])
  @@index([submittedAt])
}

// Legacy model - keeping for backward compatibility during migration
model GuestSubmission {
  id              String   @id @default(uuid())
  name            String
  email           String
  roomId          Int
  bedId           String
  checkInDate     DateTime
  checkOutDate    DateTime
  nights          Int
  calculatedPrice Float
  submittedAt     DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id])
  bed  Bed  @relation(fields: [bedId], references: [id])

  @@index([email])
  @@index([roomId])
  @@index([bedId])
  @@index([submittedAt])
}

model EmailLog {
  id          String   @id @default(uuid())
  to          String
  templateKey String
  templateId  String?
  payloadJson String? // Redacted/partial payload
  status      String // "sent" | "failed" | "pending"
  error       String?
  createdAt   DateTime @default(now())

  @@index([to])
  @@index([status])
  @@index([createdAt])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  avatarUrl       String?  // Profile image URL (e.g. from image host or Gravatar)
  chatBubbleColor String?  // Hex color for chat bubble in group chats (e.g. #3b82f6)
  travelStyle     String?  // e.g. "Up at 6am", "Just here for the vibes"
  homeCity        String?  // optional for public profile
  timezone        String?  // e.g. "America/Los_Angeles"
  // Basics (moved to account settings)
  emergencyContactName   String?
  emergencyContactPhone  String?
  shareEmergencyWithHosts Boolean @default(false)
  dietaryTags            String?  // comma-separated
  allergiesTags          String?  // comma-separated
  accessibilityNotes     String?
  // Notification preferences
  emailTripInvites     Boolean @default(true)  // Email when invited to a trip
  emailTripUpdates     Boolean @default(true)  // Email for trip updates, new activity
  inAppNotifications   Boolean @default(true)  // Show in-app notification tray
  // Profile and friends visibility
  profileVisibility    String  @default("public")   // "public" | "trip_only" | "private"
  friendsListVisibility String @default("friends")  // "friends" | "trip_members" | "private"
  createdAt       DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tripMemberships      TripMember[]
  friendRequestsSent   FriendRequest[]  @relation("FriendRequestSender")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestRecipient")
  friendshipsAsA       Friendship[]     @relation("FriendshipUserA")
  friendshipsAsB       Friendship[]     @relation("FriendshipUserB")
  invitesReceived      Invite[]              @relation("InviteRecipient")
  invitesSent          Invite[]              @relation("InviteSender")
  roomAssignments      RoomAssignment[]
  mealSlotAssignments  MealSlot[]
  mealSlotAttendances  MealSlotAttendance[]
  activityParticipants ActivityParticipant[]
  extraSelections      GuestExtraSelection[]
  rsvps                RSVP[]
  guestProfiles        GuestProfile[]
  invoices             Invoice[]
  notifications        Notification[]
  sessions             Session[]
  chatMessages         ChatMessage[]
  pollsCreated         Poll[]
  pollVotes            PollVote[]
  pollWatchers         PollWatcher[]
  captionThisRoundsAsSubmitter CaptionThisRound[]  @relation("PhotoSubmitter")
  captionThisCaptions  CaptionThisCaption[]
  captionThisVotes     CaptionThisVote[]
  captionThisScores    CaptionThisScore[]
  tripGamesAdded      TripGame[]  @relation("TripGameAddedBy")
  directMessagesSent   DirectMessage[] @relation("DirectMessageSender")
  directMessagesReceived DirectMessage[] @relation("DirectMessageRecipient")
  uploadedFiles       TripFile[]

  @@index([email])
}

// Trip games (add-on games for a trip), shared for all trip members
model TripGame {
  id             String   @id @default(uuid())
  tripId         String
  gameId         String   // scavenger-bingo | caption-this | alphabet-hunt | daily-trivia
  name           String
  addedByUserId  String
  createdAt      DateTime @default(now())

  trip    Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  addedBy User @relation("TripGameAddedBy", fields: [addedByUserId], references: [id], onDelete: Cascade)

  @@unique([tripId, gameId])
  @@index([tripId])
}

// User Sessions
model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

// Friend requests (pending → accepted creates Friendship)
model FriendRequest {
  id        String   @id @default(uuid())
  fromUserId String
  toUserId   String
  status    String   @default("pending") // "pending" | "accepted" | "declined"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromUser User @relation("FriendRequestSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("FriendRequestRecipient", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
}

// Symmetric friendship (one row per pair; store userIdA < userIdB)
model Friendship {
  id        String   @id @default(uuid())
  userIdA   String
  userIdB   String
  createdAt DateTime @default(now())

  userA User @relation("FriendshipUserA", fields: [userIdA], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipUserB", fields: [userIdB], references: [id], onDelete: Cascade)

  @@unique([userIdA, userIdB])
  @@index([userIdA])
  @@index([userIdB])
}

// Trip Members (users who are part of trips)
model TripMember {
  id           String   @id @default(uuid())
  tripId       String
  userId       String
  role         String   @default("guest") // "host" | "co-host" | "guest"
  inviteStatus String   @default("pending") // "pending" | "approved" | "denied"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
  @@index([userId, inviteStatus]) // getUserTrips filters on both fields
}

// Invites
model Invite {
  id              String    @id @default(uuid())
  tripId          String
  token           String    @unique
  invitedByUserId String
  channel         String // "email" | "sms" | "app"
  recipientEmail  String?
  recipientPhone  String?
  recipientUserId String?
  status          String    @default("sent") // "sent" | "opened" | "accepted" | "declined" | "expired"
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  trip      Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("InviteSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  recipient User? @relation("InviteRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([token])
  @@index([tripId, status]) // guests page queries pending invites by tripId + status
}

// Room Assignments (one row per bed selected for a guest; multiple rows per user for multi-bed)
// When bedId is set, (tripId, bedId) is unique so one bed can only be claimed by one guest.
model RoomAssignment {
  id        String    @id @default(uuid())
  tripId    String
  roomId    Int
  userId    String
  bedId     String?   // Specific bed when host or guest claims; unique per trip
  startDate DateTime?
  endDate   DateTime?
  partySize Int       @default(1)
  bedType   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bed  Bed? @relation(fields: [bedId], references: [id], onDelete: SetNull)

  @@unique([tripId, bedId])
  @@index([tripId])
  @@index([roomId])
  @@index([userId])
  @@index([bedId])
  @@index([tripId, userId]) // common filter: assignments for a user on a specific trip
}

// Meal Plan
model MealPlan {
  id                       String   @id @default(uuid())
  tripId                   String   @unique
  enabled                  Boolean  @default(false)
  mode                     String   @default("slots") // "slots" | "host_budget"
  hostBudgetTotal          Float?
  perGuestMealContribution Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// Meal Slots (operational meals; appear on itinerary)
model MealSlot {
  id               String   @id @default(uuid())
  tripId           String
  mealType         String // "breakfast" | "lunch" | "dinner" | "snack"
  date             DateTime
  time             String?
  title            String?  // e.g. "Breakfast, Taco Night"
  capacityServings Int?
  notes            String?
  menuText         String?
  tags             String?  // JSON array: ["vegetarian_option", "gluten_free_option"]
  assignedUserId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trip         Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  assignedUser User? @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  attendance   MealSlotAttendance[]
  files        TripFile[]

  @@index([tripId])
  @@index([date])
  @@index([assignedUserId])
}

// Per-guest attendance: opt-out and dietary note for a meal
model MealSlotAttendance {
  id           String   @id @default(uuid())
  slotId       String
  userId       String
  optedOut     Boolean  @default(false)
  optOutReason String?
  dietaryNote  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  slot MealSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([slotId, userId])
  @@index([slotId])
  @@index([userId])
}

// Activities
model Activity {
  id               String   @id @default(uuid())
  tripId           String
  title            String
  date             DateTime
  time             String?
  location         String?
  pricePerPerson   Float    @default(0)
  totalCostToSplit Float?   // When set, split evenly among participants (overrides pricePerPerson for display)
  maxParticipants  Int?
  notes            String?
  status           String   @default("planned") // "planned" | "tentative" (tentative: others can join; someone can lock as planned)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trip         Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  participants ActivityParticipant[]

  @@index([tripId])
  @@index([date])
}

// Activity Participants
model ActivityParticipant {
  id         String   @id @default(uuid())
  activityId String
  userId     String
  status     String   @default("in") // "in" | "out"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([activityId])
  @@index([userId])
}

// Extra Cost Rules
model ExtraCostRule {
  id            String   @id @default(uuid())
  tripId        String
  label         String
  amount        Float
  type          String // "flat" | "per_pet" | "per_night"
  appliesToJson String? // JSON for complex rules
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trip            Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  guestSelections GuestExtraSelection[]

  @@index([tripId])
}

// Guest Extra Selections
model GuestExtraSelection {
  id        String   @id @default(uuid())
  tripId    String
  userId    String
  ruleId    String
  quantity  Int      @default(1)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule ExtraCostRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([userId])
  @@index([ruleId])
}

// RSVPs
model RSVP {
  id                String    @id @default(uuid())
  tripId            String
  userId            String
  status            String // "yes" | "no" | "maybe"
  arrivalDatetime   DateTime?
  departureDatetime DateTime?
  adultsCount       Int       @default(1)
  kidsCount         Int       @default(0)
  petsCount         Int       @default(0)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Cost commitment (required for RSVP yes)
  costCommitmentAccepted   Boolean?
  rsvpYesAcceptedAt        DateTime?   // When guest last confirmed YES with cost range
  yesSubstatus            String?     // When status=yes: "confirmed" | "reconfirm_required"
  priceApprovedByHost      Boolean?    // Host override: true = approved, false = not approved, null = use yesSubstatus
  acceptedEstimateLowCents  Int?
  acceptedEstimateHighCents Int?
  acceptedHeadcountMin      Int?
  acceptedHeadcountMax     Int?
  acceptedCostBasisVersion  String?
  reconfirmRequiredAt      DateTime?
  reconfirmDeadlineAt      DateTime?
  latestEstimateLowCents   Int?
  latestEstimateHighCents  Int?
  latestEstimateUpdatedAt  DateTime?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
}

// Guest Profiles (trip-scoped)
model GuestProfile {
  id                  String   @id @default(uuid())
  tripId              String
  userId              String
  dietaryRestrictions String?
  allergies           String?
  phone               String?
  emergencyContact    String?
  paymentPreference   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
}

// Invoices
model Invoice {
  id                    String   @id @default(uuid())
  tripId                String
  userId                String
  totalAmount           Float
  currency              String   @default("USD")
  status                String   @default("due") // "due" | "paid" | "refunded"
  breakdownJson         String? // JSON breakdown
  stripePaymentIntentId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([tripId])
  @@index([userId])
  @@index([status])
  @@index([tripId, userId])        // invoice refresh: findFirst({ tripId, userId, status })
  @@index([tripId, userId, status]) // invoice read: findMany({ tripId, userId }) + status filter
}

// Payments
model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  provider  String // "stripe"
  amount    Float
  status    String // "pending" | "completed" | "failed" | "refunded"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([status])
}

// Notifications
model Notification {
  id              String   @id @default(uuid())
  userId          String
  type            String // "invite_received" | "invite_accepted" | "room_assigned" | etc.
  title           String
  message         String
  relatedTripId   String?
  relatedEntityId String?
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedTrip Trip? @relation(fields: [relatedTripId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

// Chat Messages (group chat for trip RSVPs)
model ChatMessage {
  id        String   @id @default(uuid())
  tripId   String
  userId   String
  message  String
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([createdAt])
  @@index([tripId, createdAt])
}

// Direct messages (anyone can message anyone)
model DirectMessage {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  message     String
  createdAt   DateTime @default(now())

  sender    User @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("DirectMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([senderId, recipientId])
  @@index([createdAt])
}

// Polls (hosts create/manage, guests vote)
model Poll {
  id               String    @id @default(uuid())
  tripId           String
  createdById      String
  title            String    // Display title (maps from legacy "question")
  description      String?
  category         String    @default("Other") // Scheduling, Meals, Activities, Rooms/Beds, Other
  pollType         String    @default("single") // single | multi | datetime
  status           String    @default("draft") // draft | open | closed | canceled
  showResultsLive  Boolean   @default(true)
  allowAnonymous   Boolean   @default(false)
  activityDate     DateTime?  // snapshot when created from Discover Activities
  activityTime     String?
  activityLocation String?
  activitySnapshot Json?      // full discover result for "View activity details" on poll
  startAt          DateTime?
  endAt            DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  trip     Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  options  PollOption[]
  votes    PollVote[]
  watchers PollWatcher[]

  @@index([tripId])
  @@index([tripId, status])
  @@index([tripId, category])
}

model PollOption {
  id        String @id @default(uuid())
  pollId    String
  label     String
  sortOrder Int    @default(0) @map("order")

  poll  Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String   @id @default(uuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, optionId])
  @@index([pollId])
  @@index([userId])
}

model PollWatcher {
  id        String   @id @default(uuid())
  pollId    String
  userId    String
  createdAt DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
}

// Activity log entries (poll created, photo added, etc.) – append-only
model TripActivity {
  id        String   @id @default(uuid())
  tripId    String
  type      String   // e.g. "poll_created", "photo_added", "guest_invited"
  summary   String   // Human-readable one-line for activity log
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([tripId, createdAt])
}

// ---- Caption This game ----
// Phase: WAITING_FOR_PHOTO | CAPTION_SUBMISSION | VOTING | RESULTS
model CaptionThisRound {
  id                    String   @id @default(uuid())
  tripId                String
  dayKey                String   // YYYY-MM-DD in trip timezone
  phase                 String   // WAITING_FOR_PHOTO | CAPTION_SUBMISSION | VOTING | RESULTS
  photoUrl              String?  @db.Text
  photoSubmitterUserId  String?
  tripTimezone          String   @default("UTC")
  endsAtMidnightTs      DateTime? // midnight in trip TZ for hard stop
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  photoSubmitter User? @relation("PhotoSubmitter", fields: [photoSubmitterUserId], references: [id], onDelete: SetNull)
  captions CaptionThisCaption[]
  votes    CaptionThisVote[]

  @@index([tripId])
  @@index([tripId, phase])
  @@index([dayKey])
}

model CaptionThisCaption {
  id        String   @id @default(uuid())
  roundId   String
  userId    String
  text      String   @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  round CaptionThisRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes CaptionThisVote[]

  @@unique([roundId, userId])
  @@index([roundId])
}

model CaptionThisVote {
  id           String   @id @default(uuid())
  roundId      String
  voterUserId  String
  captionId    String
  createdAt    DateTime @default(now())

  round   CaptionThisRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  caption CaptionThisCaption @relation(fields: [captionId], references: [id], onDelete: Cascade)
  voter   User               @relation(fields: [voterUserId], references: [id], onDelete: Cascade)

  @@unique([roundId, voterUserId])
  @@index([roundId])
  @@index([captionId])
}

// Generic trip file/attachment store
model TripFile {
  id          String   @id @default(uuid())
  tripId      String
  uploadedById String
  name        String   // original file name
  url         String   // path served by static files or external URL
  mimeType    String?
  sizeBytes   Int?
  category    String?  // e.g. "receipt", "photo", "document"
  mealSlotId  String?  // linked meal slot if this is a receipt
  notes       String?
  createdAt   DateTime @default(now())

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  uploadedBy  User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  mealSlot    MealSlot? @relation(fields: [mealSlotId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([mealSlotId])
}

model CaptionThisScore {
  id         String   @id @default(uuid())
  tripId     String
  userId     String
  pointsTotal Int     @default(0)
  updatedAt  DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
}
