# ============================================
# Database Configuration (Prisma)
# ============================================
# Pooled connection string for runtime (use connection pooler URL from Supabase)
# Format: postgresql://user:password@host:port/database?pgbouncer=true
# Port 6543 is the pooler, use this for DATABASE_URL
DATABASE_URL=postgresql://postgres.zmlmhtdrlvqqwwrodnsq:256FaDe652!@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection string for migrations (non-pooled)
# Format: postgresql://user:password@host:port/database
# Use the direct connection URL from Supabase (port 5432, not 6543)
# This is required for Prisma migrations
DIRECT_URL=postgresql://postgres.zmlmhtdrlvqqwwrodnsq:256FaDe652!@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# ============================================
# Resend (email)
# ============================================
# https://resend.com/api-keys — key starts with re_
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required. Local-part + domain must match a domain verified in THIS Resend account (dashboard shows "Verified").
RESEND_FROM_EMAIL=noreply@your-verified-domain.com
RESEND_FROM_NAME=Divvi Support

# ============================================
# Internal API Security
# ============================================
# Secret key for protecting write endpoints (generate a strong random string)
# Used for X-Internal-Api-Key header validation
# Generate with: openssl rand -hex 32
# Or use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=your-secret-api-key-here-generate-a-strong-random-string

# ============================================
# Google Maps API Configuration
# ============================================
# Google Maps API key for address autocomplete
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable "Places API" and "Maps JavaScript API"
# 4. Create credentials > API Key
# 5. Restrict the API key to "Places API" and "Maps JavaScript API" for security
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Server-side only: for Activities "Find nearby" search (Places Nearby Search, Text Search, Geocoding).
# Never expose this to the client. Same key as above can be used if you enable the required APIs.
# Enable: Places API, Geocoding API
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# ============================================
# App Configuration
# ============================================
# Base URL of your application (for email links and redirects)
# Local development: http://localhost:5173
# Production: https://your-app.vercel.app
APP_BASE_URL=http://localhost:5173

# Node environment
# Options: development, production, test
NODE_ENV=development

